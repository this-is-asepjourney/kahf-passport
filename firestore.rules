rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['super_admin', 'admin_region'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin_region']
      );
    }

    function isBA() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'ba' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ba'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isBA());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isSuperAdmin();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create: if isBA() || isAuthenticated();
      allow update: if isBA() || isAdmin() || (
        resource.data.uid == request.auth.uid || 
        request.resource.data.uid == request.auth.uid
      );
      allow delete: if isSuperAdmin();
    }

    // Products & Categories
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isBA() || 
        resource.data.customerId == request.auth.uid
      );
      allow create: if isBA() || isAdmin();
      allow update: if isBA() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Consultations
    match /consultations/{consultationId} {
      allow read: if isAuthenticated();
      allow create, update: if isBA() || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Skin Profiles
    match /skinProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // QR Tokens
    match /qrTokens/{tokenId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Stores & Regions
    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /regions/{regionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // BA Profiles
    match /baProfiles/{baId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Summaries & Aggregations
    match /dailySalesSummary/{id} {
      allow read: if isBA() || isAdmin();
      allow write: if isAdmin();
    }

    match /dailyBaSummary/{id} {
      allow read: if isBA() || isAdmin();
      allow write: if isAdmin();
    }

    match /dailyProductSummary/{id} {
      allow read: if isBA() || isAdmin();
      allow write: if isAdmin();
    }

    // Loyalty & Rewards
    match /loyaltyAccounts/{id} {
      allow read: if isAuthenticated();
      allow write: if isBA() || isAdmin();
    }

    match /loyaltyLedgers/{id} {
      allow read: if isAuthenticated();
      allow write: if isBA() || isAdmin();
    }

    match /rewards/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /rewardRedemptions/{id} {
      allow read: if isAuthenticated();
      allow write: if isBA() || isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isBA() || isAdmin());
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (isBA() || isAdmin());
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}

